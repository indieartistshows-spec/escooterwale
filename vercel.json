{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|webp|avif|svg|ico|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|llms.txt|llms-full.txt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/scooters", "destination": "/listings.html" },
    { "source": "/compare", "destination": "/compare.html" },
    { "source": "/best", "destination": "/best.html" },
    { "source": "/emi", "destination": "/emi.html" }
  ],
  "redirects": [
    {
      "source": "/scooter-detail",
      "has": [{ "type": "query", "key": "id", "value": "(?<sid>[^&]+)" }],
      "destination": "/scooters/:sid",
      "permanent": true
    },
    {
      "source": "/scooter-detail.html",
      "has": [{ "type": "query", "key": "id", "value": "(?<sid>[^&]+)" }],
      "destination": "/scooters/:sid",
      "permanent": true
    },
    {
      "source": "/brand",
      "has": [{ "type": "query", "key": "b", "value": "(?<bid>[^&]+)" }],
      "destination": "/brands/:bid",
      "permanent": true
    },
    {
      "source": "/brand.html",
      "has": [{ "type": "query", "key": "b", "value": "(?<bid>[^&]+)" }],
      "destination": "/brands/:bid",
      "permanent": true
    },
    {
      "source": "/city",
      "has": [{ "type": "query", "key": "city", "value": "(?<cid>[^&]+)" }],
      "destination": "/cities/:cid",
      "permanent": true
    },
    {
      "source": "/city.html",
      "has": [{ "type": "query", "key": "city", "value": "(?<cid>[^&]+)" }],
      "destination": "/cities/:cid",
      "permanent": true
    },
    {
      "source": "/best.html",
      "has": [{ "type": "query", "key": "cat", "value": "(?<cat>[^&]+)" }],
      "destination": "/best/:cat",
      "permanent": true
    },
    {
      "source": "/article",
      "has": [{ "type": "query", "key": "id", "value": "(?<aid>[^&]+)" }],
      "destination": "/articles/:aid",
      "permanent": true
    },
    {
      "source": "/article.html",
      "has": [{ "type": "query", "key": "id", "value": "(?<aid>[^&]+)" }],
      "destination": "/articles/:aid",
      "permanent": true
    },

    { "source": "/index.html", "destination": "/", "permanent": true },
